{
  "scenes": [0, 216, 561, 1083, 1629, 2099, 2626, 2950],
  "lines": [
    {
      "id": "x00",
      "scene": 0,
      "from": 0,
      "frames": 84,
      "text": "Один товар у вас вечно заканчивается.",
      "words": [0, 11, 23, 28, 35, 50]
    },
    {
      "id": "x01",
      "scene": 0,
      "from": 94,
      "frames": 76,
      "text": "А другой годами пылится на складе.",
      "words": [0, 4, 21, 39, 53, 58]
    },
    {
      "id": "x02",
      "scene": 0,
      "from": 180,
      "frames": 22,
      "text": "Знакомо?",
      "words": [0]
    },
    {
      "id": "x10",
      "scene": 1,
      "from": 220,
      "frames": 112,
      "text": "Обычно это объясняют невезением или плохим поставщиком.",
      "words": [0, 12, 18, 41, 64, 73, 87]
    },
    {
      "id": "x11",
      "scene": 1,
      "from": 338,
      "frames": 126,
      "text": "Но чаще всего дело в том, что все товары закупают одинаково.",
      "words": [0, 3, 19, 30, 38, 43, 49, 56, 66, 80, 102]
    },
    {
      "id": "x12",
      "scene": 1,
      "from": 470,
      "frames": 75,
      "text": "А продаются они совсем по-разному.",
      "words": [0, 3, 26, 35, 52]
    },
    {
      "id": "x20",
      "scene": 2,
      "from": 565,
      "frames": 156,
      "text": "XYZ-анализ делит товары по тому, насколько ровно они продаются.",
      "words": [0, 47, 59, 72, 77, 86, 106, 122, 131]
    },
    {
      "id": "x21",
      "scene": 2,
      "from": 729,
      "frames": 88,
      "text": "X — стабильные, как хлеб и молоко.",
      "words": [0, 17, 45, 52, 64, 69]
    },
    {
      "id": "x22",
      "scene": 2,
      "from": 825,
      "frames": 90,
      "text": "Y — с волнами: сезон, праздники.",
      "words": [0, 18, 23, 46, 62]
    },
    {
      "id": "x23",
      "scene": 2,
      "from": 923,
      "frames": 142,
      "text": "Z — непредсказуемые: сегодня пять штук, потом месяц ни одной.",
      "words": [0, 19, 63, 77, 85, 99, 108, 123, 130]
    },
    {
      "id": "x30",
      "scene": 3,
      "from": 1087,
      "frames": 152,
      "text": "У ABC-анализа есть автор и дата. У XYZ — нет.",
      "words": [0, 22, 45, 54, 68, 75, 93, 116, 140]
    },
    {
      "id": "x31",
      "scene": 3,
      "from": 1245,
      "frames": 165,
      "text": "Его собрали логисты, а главную формулу взяли у британского статистика Карла Пирсона.",
      "words": [0, 6, 23, 41, 46, 62, 76, 86, 89, 108, 131, 145]
    },
    {
      "id": "x32",
      "scene": 3,
      "from": 1416,
      "frames": 197,
      "text": "В 1896 году он придумал, как измерить, насколько число «скачет» вокруг среднего.",
      "words": [0, 27, 54, 64, 71, 89, 96, 114, 131, 147, 165, 178]
    },
    {
      "id": "x40",
      "scene": 4,
      "from": 1633,
      "frames": 163,
      "text": "И самое интересное: единых границ между X, Y и Z до сих пор нет.",
      "words": [0, 3, 16, 41, 59, 77, 89, 100, 112, 120, 127, 132, 143, 153]
    },
    {
      "id": "x41",
      "scene": 4,
      "from": 1802,
      "frames": 157,
      "text": "В одних учебниках X — до 10% колебаний, в других — до 25%.",
      "words": [0, 1, 12, 27, 43, 61, 80, 100, 106, 121, 136]
    },
    {
      "id": "x42",
      "scene": 4,
      "from": 1965,
      "frames": 118,
      "text": "Поэтому границы под ваш магазин надо подбирать, а не копировать.",
      "words": [0, 12, 30, 36, 42, 57, 67, 86, 90, 96]
    },
    {
      "id": "x50",
      "scene": 5,
      "from": 2103,
      "frames": 69,
      "text": "А теперь соедините с ABC.",
      "words": [0, 5, 17, 41, 52]
    },
    {
      "id": "x51",
      "scene": 5,
      "from": 2178,
      "frames": 50,
      "text": "Получится девять групп.",
      "words": [0, 22, 37]
    },
    {
      "id": "x52",
      "scene": 5,
      "from": 2234,
      "frames": 170,
      "text": "AX — главные деньги и ровный спрос: держите всегда, закупайте регулярно.",
      "words": [0, 22, 45, 57, 63, 77, 93, 112, 125, 148]
    },
    {
      "id": "x53",
      "scene": 5,
      "from": 2410,
      "frames": 130,
      "text": "CZ — мало денег и хаос: первый кандидат на вывод.",
      "words": [0, 30, 43, 56, 64, 83, 95, 113, 118]
    },
    {
      "id": "x54",
      "scene": 5,
      "from": 2546,
      "frames": 62,
      "text": "Остальные — где-то посередине.",
      "words": [0, 23, 36]
    },
    {
      "id": "x60",
      "scene": 6,
      "from": 2630,
      "frames": 172,
      "text": "Как разложить ваш ассортимент по этой сетке и что делать с каждой группой — рассказываю в канале.",
      "words": [
        0, 5, 22, 29, 49, 53, 61, 75, 81, 89, 99, 103, 113, 131, 151, 156
      ]
    },
    {
      "id": "x61",
      "scene": 6,
      "from": 2808,
      "frames": 62,
      "text": "Ссылка в описании — заходите.",
      "words": [0, 13, 18, 39]
    }
  ]
}
