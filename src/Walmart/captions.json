{
  "scenes": [0, 333, 689, 1031, 1337, 1647, 2044, 2263, 2525, 3040, 3249, 3472],
  "lines": [
    {
      "id": "w000",
      "scene": 0,
      "from": 0,
      "frames": 124,
      "text": "В мире ритейла каждый товар на полке рассказывает свою историю.",
      "words": [0, 4, 12, 32, 44, 55, 60, 73, 92, 104]
    },
    {
      "id": "w001",
      "scene": 0,
      "from": 132,
      "frames": 116,
      "text": "Но самые ценные открытия приходят не из того, что люди говорят,",
      "words": [0, 5, 20, 33, 48, 63, 66, 71, 78, 86, 96]
    },
    {
      "id": "w002",
      "scene": 0,
      "from": 256,
      "frames": 63,
      "text": "а из того, что они покупают.",
      "words": [0, 2, 9, 21, 30, 38]
    },
    {
      "id": "w010",
      "scene": 1,
      "from": 337,
      "frames": 119,
      "text": "В конце 1990-х американская сеть Walmart начала эксперимент.",
      "words": [0, 1, 17, 33, 53, 67, 81, 93]
    },
    {
      "id": "w011",
      "scene": 1,
      "from": 464,
      "frames": 64,
      "text": "Анализ покупательской корзины.",
      "words": [0, 17, 44]
    },
    {
      "id": "w012",
      "scene": 1,
      "from": 536,
      "frames": 139,
      "text": "Метод, который ищет связи между товарами, которые часто покупают вместе.",
      "words": [0, 13, 25, 39, 51, 59, 75, 90, 101, 119]
    },
    {
      "id": "w020",
      "scene": 2,
      "from": 693,
      "frames": 37,
      "text": "Идея была простой.",
      "words": [0, 12, 21]
    },
    {
      "id": "w021",
      "scene": 2,
      "from": 738,
      "frames": 118,
      "text": "Найди такие пары — и сможешь принимать более умные решения:",
      "words": [0, 11, 24, 36, 41, 56, 72, 83, 100]
    },
    {
      "id": "w022",
      "scene": 2,
      "from": 864,
      "frames": 153,
      "text": "как расставить магазин, какие делать совместные акции и как планировать запасы.",
      "words": [0, 4, 22, 41, 53, 62, 83, 98, 106, 114, 136]
    },
    {
      "id": "w030",
      "scene": 3,
      "from": 1035,
      "frames": 104,
      "text": "Проанализировали тысячи чеков и миллионы покупок.",
      "words": [0, 30, 45, 58, 64, 84]
    },
    {
      "id": "w031",
      "scene": 3,
      "from": 1147,
      "frames": 86,
      "text": "Каждый пробитый штрихкод стал точкой данных.",
      "words": [0, 10, 26, 45, 52, 69]
    },
    {
      "id": "w032",
      "scene": 3,
      "from": 1241,
      "frames": 82,
      "text": "И алгоритм нашёл кое-что неожиданное.",
      "words": [0, 1, 22, 38, 53]
    },
    {
      "id": "w040",
      "scene": 4,
      "from": 1341,
      "frames": 119,
      "text": "Среди привычных пар — хлеб и масло, чипсы и газировка —",
      "words": [0, 11, 32, 42, 55, 60, 75, 87, 92]
    },
    {
      "id": "w041",
      "scene": 4,
      "from": 1468,
      "frames": 60,
      "text": "выделилась странная парочка.",
      "words": [0, 20, 40]
    },
    {
      "id": "w042",
      "scene": 4,
      "from": 1536,
      "frames": 55,
      "text": "Подгузники и пиво.",
      "words": [0, 30, 37]
    },
    {
      "id": "w043",
      "scene": 4,
      "from": 1599,
      "frames": 32,
      "text": "Это не шутка.",
      "words": [0, 8, 14]
    },
    {
      "id": "w050",
      "scene": 5,
      "from": 1651,
      "frames": 176,
      "text": "Данные показали: по пятницам вечером молодые мужчины, часто недавно ставшие отцами,",
      "words": [0, 17, 45, 49, 67, 83, 98, 116, 127, 140, 153]
    },
    {
      "id": "w051",
      "scene": 5,
      "from": 1835,
      "frames": 65,
      "text": "заходили за подгузниками для малышей",
      "words": [0, 14, 19, 42, 47]
    },
    {
      "id": "w052",
      "scene": 5,
      "from": 1908,
      "frames": 122,
      "text": "и на выходе прихватывали упаковку пива — посмотреть вечерний матч.",
      "words": [0, 3, 9, 22, 41, 61, 76, 91, 111]
    },
    {
      "id": "w060",
      "scene": 6,
      "from": 2048,
      "frames": 72,
      "text": "Никакой опрос этого бы не выявил.",
      "words": [0, 20, 34, 45, 50, 55]
    },
    {
      "id": "w061",
      "scene": 6,
      "from": 2128,
      "frames": 73,
      "text": "Но анализу корзины не нужно спрашивать.",
      "words": [0, 3, 20, 35, 41, 51]
    },
    {
      "id": "w062",
      "scene": 6,
      "from": 2209,
      "frames": 40,
      "text": "Он просто наблюдает.",
      "words": [0, 6, 15]
    },
    {
      "id": "w070",
      "scene": 7,
      "from": 2267,
      "frames": 121,
      "text": "Walmart переставил полки и поставил пиво ближе к подгузникам.",
      "words": [0, 17, 37, 50, 54, 71, 82, 92, 96]
    },
    {
      "id": "w071",
      "scene": 7,
      "from": 2398,
      "frames": 23,
      "text": "Результат?",
      "words": [0]
    },
    {
      "id": "w072",
      "scene": 7,
      "from": 2431,
      "frames": 80,
      "text": "Заметный рост продаж пива в эти часы.",
      "words": [0, 23, 32, 45, 54, 59, 68]
    },
    {
      "id": "w080",
      "scene": 8,
      "from": 2529,
      "frames": 146,
      "text": "Этот случай стал одним из самых цитируемых примеров торговли на основе данных.",
      "words": [0, 7, 22, 28, 39, 45, 54, 78, 94, 109, 114, 129]
    },
    {
      "id": "w081",
      "scene": 8,
      "from": 2683,
      "frames": 127,
      "text": "Сегодня анализ корзины — это гораздо больше, чем расстановка полок.",
      "words": [0, 16, 33, 50, 58, 75, 86, 93, 113]
    },
    {
      "id": "w082",
      "scene": 8,
      "from": 2818,
      "frames": 208,
      "text": "На нём держатся персональные рекомендации, динамические цены и точечные акции — в магазине и онлайн.",
      "words": [0, 3, 10, 23, 43, 69, 97, 109, 117, 137, 156, 161, 183, 189]
    },
    {
      "id": "w090",
      "scene": 9,
      "from": 3044,
      "frames": 95,
      "text": "Но всё началось с одного неожиданного открытия.",
      "words": [0, 5, 13, 30, 36, 47, 73]
    },
    {
      "id": "w091",
      "scene": 9,
      "from": 3147,
      "frames": 88,
      "text": "Купил подгузники — возможно, купишь и пиво.",
      "words": [0, 11, 39, 57, 70, 76]
    },
    {
      "id": "w100",
      "scene": 10,
      "from": 3253,
      "frames": 129,
      "text": "Хотите найти такие пары в своём магазине? Ссылка в описании.",
      "words": [0, 11, 23, 32, 42, 46, 58, 80, 102, 107]
    }
  ]
}
