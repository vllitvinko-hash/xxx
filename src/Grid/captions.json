{
  "scenes": [0, 180, 480, 840, 1080, 1380, 1680, 2040, 2340, 2580, 2760],
  "lines": [
    {
      "id": "g00",
      "scene": 0,
      "from": 8,
      "frames": 68,
      "text": "Полки идеальные. Ценники ровные.",
      "words": null
    },
    {
      "id": "g01",
      "scene": 0,
      "from": 82,
      "frames": 81,
      "text": "А средний чек — тот же, что год назад.",
      "words": null
    },
    {
      "id": "g10",
      "scene": 1,
      "from": 188,
      "frames": 35,
      "text": "Мерчендайзинг — нужная вещь.",
      "words": null
    },
    {
      "id": "g11",
      "scene": 1,
      "from": 229,
      "frames": 111,
      "text": "Но он смотрит на магазин вертикально: полка за полкой, категория за категорией.",
      "words": null
    },
    {
      "id": "g12",
      "scene": 1,
      "from": 346,
      "frames": 53,
      "text": "Как выложить соусы, чтобы их было видно.",
      "words": null
    },
    {
      "id": "g13",
      "scene": 1,
      "from": 405,
      "frames": 56,
      "text": "Как расставить молочку, чтобы было удобно.",
      "words": null
    },
    {
      "id": "g20",
      "scene": 2,
      "from": 488,
      "frames": 67,
      "text": "А покупатель ходит по магазину горизонтально.",
      "words": null
    },
    {
      "id": "g21",
      "scene": 2,
      "from": 561,
      "frames": 31,
      "text": "Через все отделы сразу.",
      "words": null
    },
    {
      "id": "g22",
      "scene": 2,
      "from": 598,
      "frames": 109,
      "text": "Он берёт соус вместе с макаронами, хотя они стоят в разных концах зала.",
      "words": null
    },
    {
      "id": "g23",
      "scene": 2,
      "from": 713,
      "frames": 109,
      "text": "Эту линию видно только в чеке — одна покупка, товары из разных отделов.",
      "words": null
    },
    {
      "id": "g30",
      "scene": 3,
      "from": 848,
      "frames": 51,
      "text": "Мерчендайзинг видит вертикаль.",
      "words": null
    },
    {
      "id": "g31",
      "scene": 3,
      "from": 905,
      "frames": 45,
      "text": "Анализ чеков — горизонталь.",
      "words": null
    },
    {
      "id": "g32",
      "scene": 3,
      "from": 956,
      "frames": 106,
      "text": "И вот четыре вещи, которые по вертикали не увидеть никогда.",
      "words": null
    },
    {
      "id": "g40",
      "scene": 4,
      "from": 1088,
      "frames": 134,
      "text": "Первое. По вертикали выкладывают «как принято»: в каждой категории свои правила.",
      "words": null
    },
    {
      "id": "g41",
      "scene": 4,
      "from": 1228,
      "frames": 135,
      "text": "Но что берут вместе именно ваши покупатели — видно только поперёк, в ваших чеках.",
      "words": null
    },
    {
      "id": "g50",
      "scene": 5,
      "from": 1388,
      "frames": 140,
      "text": "Второе. Часто вертикаль диктует поставщик: его товар — на лучшем месте его полки.",
      "words": null
    },
    {
      "id": "g51",
      "scene": 5,
      "from": 1534,
      "frames": 129,
      "text": "Он думает о своей категории, а не о том, что ещё человек положит в корзину.",
      "words": null
    },
    {
      "id": "g60",
      "scene": 6,
      "from": 1688,
      "frames": 137,
      "text": "Третье. По вертикали товар слабый — внизу своей категории, кандидат на вывод.",
      "words": null
    },
    {
      "id": "g61",
      "scene": 6,
      "from": 1831,
      "frames": 149,
      "text": "А по горизонтали видно, что с ним в чеке лежат дорогие покупки из соседнего отдела.",
      "words": null
    },
    {
      "id": "g62",
      "scene": 6,
      "from": 1986,
      "frames": 36,
      "text": "Убрали — и потеряли их.",
      "words": null
    },
    {
      "id": "g70",
      "scene": 7,
      "from": 2048,
      "frames": 109,
      "text": "Четвёртое. По вертикали можно увидеть, что товар стал продаваться лучше.",
      "words": null
    },
    {
      "id": "g71",
      "scene": 7,
      "from": 2163,
      "frames": 160,
      "text": "Но только по горизонтали видно, вырос ли от этого весь чек — или человек просто взял его вместо другого.",
      "words": null
    },
    {
      "id": "g80",
      "scene": 8,
      "from": 2348,
      "frames": 64,
      "text": "Мерчендайзинг — это вертикаль: порядок на каждой полке.",
      "words": null
    },
    {
      "id": "g81",
      "scene": 8,
      "from": 2418,
      "frames": 62,
      "text": "Анализ чеков — горизонталь: связи через весь магазин.",
      "words": null
    },
    {
      "id": "g82",
      "scene": 8,
      "from": 2486,
      "frames": 34,
      "text": "Вместе они дают полную картину.",
      "words": null
    },
    {
      "id": "g83",
      "scene": 8,
      "from": 2526,
      "frames": 36,
      "text": "По отдельности — только половину.",
      "words": null
    },
    {
      "id": "g90",
      "scene": 9,
      "from": 2588,
      "frames": 115,
      "text": "Как увидеть горизонталь вашего магазина — на сайте.",
      "words": null
    },
    {
      "id": "g91",
      "scene": 9,
      "from": 2709,
      "frames": 34,
      "text": "Ссылка в профиле.",
      "words": null
    }
  ]
}
