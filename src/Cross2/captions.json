{
  "scenes": [0, 231, 619, 983, 1509, 1813, 2118, 2600, 2814, 2997, 3224],
  "lines": [
    {
      "id": "c00",
      "scene": 0,
      "from": 0,
      "frames": 92,
      "text": "«Что-нибудь ещё?» — худшая фраза на кассе.",
      "words": [0, 18, 38, 59, 70, 76]
    },
    {
      "id": "c01",
      "scene": 0,
      "from": 100,
      "frames": 80,
      "text": "Вот пять правил, которые работают лучше.",
      "words": [0, 10, 20, 35, 47, 64]
    },
    {
      "id": "c02",
      "scene": 0,
      "from": 188,
      "frames": 27,
      "text": "Сохраните.",
      "words": [0]
    },
    {
      "id": "c10",
      "scene": 1,
      "from": 235,
      "frames": 129,
      "text": "Кросс-продажа — это когда к выбранному товару предлагают то, что к нему подходит.",
      "words": [0, 25, 33, 41, 45, 61, 72, 89, 94, 99, 102, 111]
    },
    {
      "id": "c11",
      "scene": 1,
      "from": 372,
      "frames": 128,
      "text": "Работает везде: в кофейне, аптеке, салоне, автосервисе.",
      "words": [0, 19, 36, 41, 60, 79, 96]
    },
    {
      "id": "c12",
      "scene": 1,
      "from": 508,
      "frames": 97,
      "text": "И без копейки на рекламу — покупатель уже у вас.",
      "words": [0, 2, 8, 23, 28, 44, 68, 79, 85]
    },
    {
      "id": "c20",
      "scene": 2,
      "from": 623,
      "frames": 119,
      "text": "Первое: не спрашивайте «да или нет» — дайте выбор из двух.",
      "words": [0, 17, 23, 49, 58, 67, 79, 91, 103, 109]
    },
    {
      "id": "c21",
      "scene": 2,
      "from": 750,
      "frames": 89,
      "text": "«Что-нибудь ещё?» почти всегда слышит «нет».",
      "words": [0, 18, 33, 46, 59, 76]
    },
    {
      "id": "c22",
      "scene": 2,
      "from": 847,
      "frames": 122,
      "text": "А «круассан или маффин?» заставляет выбирать, а не отказываться.",
      "words": [1, 9, 31, 37, 53, 73, 89, 92, 98]
    },
    {
      "id": "c30",
      "scene": 3,
      "from": 987,
      "frames": 111,
      "text": "Второе: предлагайте то, без чего покупка не заработает.",
      "words": [0, 20, 42, 48, 56, 64, 80, 86]
    },
    {
      "id": "c31",
      "scene": 3,
      "from": 1106,
      "frames": 104,
      "text": "Батарейки к игрушке, кабель к зарядке, розжиг к углю.",
      "words": [0, 16, 18, 36, 48, 52, 68, 84, 91]
    },
    {
      "id": "c32",
      "scene": 3,
      "from": 1218,
      "frames": 100,
      "text": "Никто не хочет прийти домой и понять, что чего-то не хватает.",
      "words": [0, 10, 15, 24, 34, 45, 48, 59, 64, 77, 82]
    },
    {
      "id": "c33",
      "scene": 3,
      "from": 1326,
      "frames": 167,
      "text": "Пройдитесь по двадцати самым продаваемым товарам и спросите: чего покупателю не хватит дома?",
      "words": [0, 15, 20, 35, 45, 62, 79, 82, 103, 113, 136, 141, 155]
    },
    {
      "id": "c40",
      "scene": 4,
      "from": 1513,
      "frames": 76,
      "text": "Третье: лучший продавец — полка.",
      "words": [0, 17, 35, 58]
    },
    {
      "id": "c41",
      "scene": 4,
      "from": 1597,
      "frames": 76,
      "text": "Поставьте пару на расстоянии вытянутой руки.",
      "words": [0, 14, 24, 29, 46, 65]
    },
    {
      "id": "c42",
      "scene": 4,
      "from": 1681,
      "frames": 118,
      "text": "Соус рядом с пастой продаёт сам, даже когда продавец молчит.",
      "words": [0, 13, 22, 26, 38, 55, 66, 75, 85, 102]
    },
    {
      "id": "c50",
      "scene": 5,
      "from": 1817,
      "frames": 71,
      "text": "Четвёртое: дайте паре имя.",
      "words": [0, 26, 40, 55]
    },
    {
      "id": "c51",
      "scene": 5,
      "from": 1896,
      "frames": 111,
      "text": "Не «уголь, розжиг и шампуры», а «набор на шашлык».",
      "words": [1, 9, 24, 38, 42, 52, 63, 87, 91]
    },
    {
      "id": "c52",
      "scene": 5,
      "from": 2015,
      "frames": 89,
      "text": "Три товара — три решения. Набор — одно.",
      "words": [0, 7, 24, 34, 54, 74]
    },
    {
      "id": "c60",
      "scene": 6,
      "from": 2122,
      "frames": 142,
      "text": "Пятое: платите продавцу за допродажу и проверяйте одну пару в неделю.",
      "words": [0, 16, 33, 49, 63, 77, 82, 102, 113, 123, 126]
    },
    {
      "id": "c61",
      "scene": 6,
      "from": 2272,
      "frames": 72,
      "text": "Без бонуса предлагать быстро перестают.",
      "words": [0, 7, 22, 38, 50]
    },
    {
      "id": "c62",
      "scene": 6,
      "from": 2352,
      "frames": 124,
      "text": "Небольшая сумма за каждую допродажу — и каждую неделю новая пара.",
      "words": [0, 15, 28, 31, 47, 63, 70, 83, 97, 112]
    },
    {
      "id": "c63",
      "scene": 6,
      "from": 2484,
      "frames": 102,
      "text": "Посчитали, сколько раз взяли, оставили то, что работает.",
      "words": [0, 16, 26, 32, 49, 69, 75, 83]
    },
    {
      "id": "c70",
      "scene": 7,
      "from": 2604,
      "frames": 105,
      "text": "А какие пары предлагать именно у вас — подскажут ваши чеки.",
      "words": [0, 1, 12, 23, 38, 49, 54, 61, 80, 92]
    },
    {
      "id": "c71",
      "scene": 7,
      "from": 2717,
      "frames": 83,
      "text": "Там видно, что люди и так покупают вместе.",
      "words": [0, 6, 17, 24, 33, 39, 47, 64]
    },
    {
      "id": "c80",
      "scene": 8,
      "from": 2818,
      "frames": 73,
      "text": "Это шпаргалка — поставьте на паузу.",
      "words": [0, 8, 34, 51, 57]
    },
    {
      "id": "c81",
      "scene": 8,
      "from": 2899,
      "frames": 96,
      "text": "Про апсейл и даунсейл — следующие ролики в канале.",
      "words": [0, 4, 23, 36, 49, 66, 78, 83]
    },
    {
      "id": "c82",
      "scene": 9,
      "from": 3003,
      "frames": 41,
      "text": "Ссылка в описании.",
      "words": [0, 16, 20]
    }
  ]
}
