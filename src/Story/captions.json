 "lines": [
  {
   "id": "s1a",
   "scene": 0,
   "from": 0,
   "frames": 66,
   "text": "Покупатель взял пиво."
  },
  {
   "id": "s1b",
   "scene": 0,
   "from": 76,
   "frames": 66,
   "text": "И ушёл без чипсов."
  },
  {
   "id": "s2a",
   "scene": 1,
   "from": 174,
   "frames": 118,
   "text": "Такое происходит в вашем магазине сотни раз в день."
  },
  {
   "id": "s2b",
   "scene": 1,
   "from": 304,
   "frames": 204,
   "text": "И вы этого не видите — потому что смотрите на продажи товаров, а не на связи между ними."
  },
  {
   "id": "s3a",
   "scene": 2,
   "from": 546,
   "frames": 102,
   "text": "А в чеках уже записано, что покупают вместе."
  },
  {
   "id": "s3b",
   "scene": 2,
   "from": 662,
   "frames": 141,
   "text": "Какие пары работают как магнит, а какие — убивают друг друга."
  },
  {
   "id": "s4a",
   "scene": 3,
   "from": 851,
   "frames": 95,
   "text": "Я анализирую ваши чеки и нахожу три вещи."
  },
  {
   "id": "s4b",
   "scene": 3,
   "from": 986,
   "frames": 97,
   "text": "Золотые пары, которые стоит ставить рядом."
  },
  {
   "id": "s4c",
   "scene": 3,
   "from": 1123,
   "frames": 102,
   "text": "Скрытые связи, о которых вы не догадывались."
  },
  {
   "id": "s4d",
   "scene": 3,
   "from": 1265,
   "frames": 109,
   "text": "И опасные пары, которые съедают маржу в акциях."
  },
  {
   "id": "s5a",
   "scene": 4,
   "from": 1432,
   "frames": 144,
   "text": "На выходе — не отчёт ради отчёта, а топ-20 конкретных решений."
  },
  {
   "id": "s5b",
   "scene": 4,
   "from": 1592,
   "frames": 148,
   "text": "Что переставить, что объединить в комплект, что убрать из промо."
  },
  {
   "id": "s5c",
   "scene": 4,
   "from": 1756,
   "frames": 66,
   "text": "С цифрами и объяснением."
  },
  {
   "id": "s6a",
   "scene": 5,
   "from": 1870,
   "frames": 169,
   "text": "Без внедрения систем и без доступа к вашей кассе — только выгрузка чеков."
  },
  {
   "id": "s6b",
   "scene": 5,
   "from": 2053,
   "frames": 66,
   "text": "Разово, быстро, понятно."
  },
  {
   "id": "s7a",
   "scene": 6,
   "from": 2167,
   "frames": 100,
   "text": "Хотите проверить, что скрыто в ваших чеках?"
  },
  {
   "id": "s7b",
   "scene": 6,
   "from": 2279,
   "frames": 90,
   "text": "Начните с бесплатного экспресс-разбора."
  },
  {
   "id": "s7c",
   "scene": 6,
   "from": 2381,
   "frames": 66,
   "text": "Пишите — ссылка ниже."
  }
 ]
}