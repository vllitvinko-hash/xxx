{
  "scenes": [0, 125, 426, 688, 1181, 1552, 1800, 2117],
  "lines": [
    {
      "id": "s1a",
      "scene": 0,
      "from": 0,
      "frames": 50,
      "text": "Покупатель взял пиво.",
      "words": [0, 18, 33]
    },
    {
      "id": "s1b",
      "scene": 0,
      "from": 62,
      "frames": 45,
      "text": "И ушёл без чипсов.",
      "words": [0, 3, 17, 24]
    },
    {
      "id": "s2a",
      "scene": 1,
      "from": 131,
      "frames": 99,
      "text": "Такое происходит в вашем магазине сотни раз в день.",
      "words": [0, 10, 27, 30, 40, 59, 76, 82, 88]
    },
    {
      "id": "s2b",
      "scene": 1,
      "from": 236,
      "frames": 170,
      "text": "И вы этого не видите — потому что смотрите на продажи товаров, а не на связи между ними.",
      "words": [
        0, 3, 14, 25, 31, 50, 59, 65, 80, 85, 99, 119, 122, 126, 133, 146, 156
      ]
    },
    {
      "id": "s3a",
      "scene": 2,
      "from": 432,
      "frames": 93,
      "text": "А в чеках уже записано, что покупают вместе.",
      "words": [2, 7, 22, 30, 48, 54, 70, 93]
    },
    {
      "id": "s3b",
      "scene": 2,
      "from": 531,
      "frames": 133,
      "text": "Какие пары работают как магнит, а какие — убивают друг друга.",
      "words": null
    },
    {
      "id": "s4a",
      "scene": 3,
      "from": 694,
      "frames": 101,
      "text": "Я анализирую ваши чеки и нахожу три вещи.",
      "words": [0, 7, 32, 42, 53, 57, 74, 81]
    },
    {
      "id": "s4b",
      "scene": 3,
      "from": 819,
      "frames": 88,
      "text": "Золотые пары, которые стоит ставить рядом.",
      "words": [18, 32, 43, 57, 71, 86]
    },
    {
      "id": "s4c",
      "scene": 3,
      "from": 931,
      "frames": 86,
      "text": "Скрытые связи, о которых вы не догадывались.",
      "words": [18, 32, 35, 48, 53, 57, 84]
    },
    {
      "id": "s4d",
      "scene": 3,
      "from": 1041,
      "frames": 110,
      "text": "И опасные пары, которые съедают маржу в акциях.",
      "words": [6, 29, 42, 54, 73, 85, 89, 111]
    },
    {
      "id": "s5a",
      "scene": 4,
      "from": 1187,
      "frames": 143,
      "text": "На выходе — не отчёт ради отчёта, а топ-20 конкретных решений.",
      "words": [5, 25, 29, 43, 52, 72, 85, 102, 124, 142]
    },
    {
      "id": "s5b",
      "scene": 4,
      "from": 1336,
      "frames": 128,
      "text": "Что переставить, что объединить в комплект, что убрать из промо.",
      "words": [8, 33, 41, 59, 64, 83, 92, 106, 112, 126]
    },
    {
      "id": "s5c",
      "scene": 4,
      "from": 1470,
      "frames": 58,
      "text": "С цифрами и объяснением.",
      "words": null
    },
    {
      "id": "s6a",
      "scene": 5,
      "from": 1558,
      "frames": 148,
      "text": "Без внедрения систем и без доступа к вашей кассе — только выгрузка чеков.",
      "words": [0, 8, 27, 42, 48, 56, 72, 75, 86, 103, 112, 132]
    },
    {
      "id": "s6b",
      "scene": 5,
      "from": 1712,
      "frames": 64,
      "text": "Разово, быстро, понятно.",
      "words": [2, 22, 39]
    },
    {
      "id": "s7a",
      "scene": 6,
      "from": 1806,
      "frames": 80,
      "text": "Хотите проверить, что скрыто в ваших чеках?",
      "words": [12, 28, 34, 47, 51, 63, 79]
    },
    {
      "id": "s7b",
      "scene": 6,
      "from": 1892,
      "frames": 78,
      "text": "Начните с бесплатного экспресс-разбора.",
      "words": [16, 21, 41, 58]
    },
    {
      "id": "s7c",
      "scene": 6,
      "from": 1976,
      "frames": 51,
      "text": "Пишите — ссылка ниже.",
      "words": null
    }
  ]
}
