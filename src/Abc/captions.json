{
  "scenes": [0, 182, 589, 965, 1221, 1784, 2175, 2503, 2839],
  "lines": [
    {
      "id": "a00",
      "scene": 0,
      "from": 0,
      "frames": 72,
      "text": "В вашем магазине сотни товаров.",
      "words": [2, 5, 16, 35, 52]
    },
    {
      "id": "a01",
      "scene": 0,
      "from": 82,
      "frames": 86,
      "text": "Но кормят вас от силы два десятка из них.",
      "words": [0, 1, 17, 23, 29, 40, 50, 65, 71]
    },
    {
      "id": "a10",
      "scene": 1,
      "from": 186,
      "frames": 104,
      "text": "Это заметили ещё в 1951 году.",
      "words": [0, 1, 20, 25, 57, 88]
    },
    {
      "id": "a11",
      "scene": 1,
      "from": 296,
      "frames": 151,
      "text": "Менеджер General Electric Форд Дики устал от складов, забитых всем подряд,",
      "words": [0, 11, 23, 34, 48, 62, 75, 80, 95, 111, 119]
    },
    {
      "id": "a12",
      "scene": 1,
      "from": 453,
      "frames": 122,
      "text": "и разделил товары на три группы: A, B и C.",
      "words": [0, 2, 18, 32, 38, 45, 63, 82, 100, 107]
    },
    {
      "id": "a20",
      "scene": 2,
      "from": 593,
      "frames": 107,
      "text": "A — немного товаров, которые дают основную выручку.",
      "words": [0, 2, 22, 39, 48, 60, 77]
    },
    {
      "id": "a21",
      "scene": 2,
      "from": 706,
      "frames": 44,
      "text": "B — середина.",
      "words": [0, 16]
    },
    {
      "id": "a22",
      "scene": 2,
      "from": 756,
      "frames": 191,
      "text": "C — длинный хвост, который почти ничего не приносит, но занимает место и замораживает деньги.",
      "words": [0, 11, 35, 51, 60, 73, 83, 89, 107, 113, 133, 146, 150, 177]
    },
    {
      "id": "a30",
      "scene": 3,
      "from": 969,
      "frames": 163,
      "text": "Свою статью он назвал примерно так: «Охотьтесь за долларами, а не за копейками».",
      "words": [0, 2, 17, 23, 36, 54, 75, 95, 101, 122, 125, 129, 133]
    },
    {
      "id": "a31",
      "scene": 3,
      "from": 1140,
      "frames": 67,
      "text": "Это и есть вся суть метода.",
      "words": [1, 11, 19, 29, 39, 51]
    },
    {
      "id": "a40",
      "scene": 4,
      "from": 1225,
      "frames": 182,
      "text": "А правило 80 на 20, на котором всё держится, связывают с итальянцем Вильфредо Парето.",
      "words": [0, 1, 20, 39, 47, 55, 61, 73, 81, 99, 115, 118, 137, 156]
    },
    {
      "id": "a41",
      "scene": 4,
      "from": 1413,
      "frames": 90,
      "text": "Хотя назвал его так американец Джозеф Джуран.",
      "words": [0, 1, 15, 21, 27, 48, 65]
    },
    {
      "id": "a42",
      "scene": 4,
      "from": 1509,
      "frames": 163,
      "text": "И в 1975 году сам публично признал, что дал правилу не то имя.",
      "words": [0, 1, 29, 57, 69, 77, 94, 107, 114, 124, 137, 143, 149]
    },
    {
      "id": "a43",
      "scene": 4,
      "from": 1678,
      "frames": 90,
      "text": "Мог бы назвать «принцип Джурана», но не стал.",
      "words": [0, 1, 5, 21, 36, 59, 65, 72]
    },
    {
      "id": "a50",
      "scene": 5,
      "from": 1788,
      "frames": 50,
      "text": "Что это значит для вас:",
      "words": [0, 1, 10, 23, 31]
    },
    {
      "id": "a51",
      "scene": 5,
      "from": 1844,
      "frames": 132,
      "text": "товары группы A должны быть всегда в наличии и на лучших местах.",
      "words": [1, 17, 28, 40, 54, 63, 72, 77, 94, 99, 104, 120]
    },
    {
      "id": "a52",
      "scene": 5,
      "from": 1982,
      "frames": 92,
      "text": "Нет их на полке — вы теряете главные деньги.",
      "words": [0, 1, 8, 12, 28, 35, 53, 72]
    },
    {
      "id": "a53",
      "scene": 5,
      "from": 2080,
      "frames": 81,
      "text": "А группа C — первая на сокращение.",
      "words": [0, 1, 16, 31, 46, 51]
    },
    {
      "id": "a60",
      "scene": 6,
      "from": 2179,
      "frames": 97,
      "text": "Но ABC показывает только, что продаётся.",
      "words": [0, 11, 22, 43, 54, 65]
    },
    {
      "id": "a61",
      "scene": 6,
      "from": 2282,
      "frames": 115,
      "text": "А с чем продаётся ваш товар A — уже следующий уровень.",
      "words": [0, 1, 8, 15, 35, 44, 56, 68, 77, 99]
    },
    {
      "id": "a62",
      "scene": 6,
      "from": 2403,
      "frames": 86,
      "text": "Именно там прячется рост среднего чека.",
      "words": [1, 16, 25, 46, 57, 75]
    },
    {
      "id": "a70",
      "scene": 7,
      "from": 2507,
      "frames": 92,
      "text": "Как это найти в ваших продажах — рассказываю в канале.",
      "words": [0, 1, 6, 17, 21, 31, 49, 69, 74]
    },
    {
      "id": "a71",
      "scene": 7,
      "from": 2605,
      "frames": 87,
      "text": "Там ещё больше приёмов для магазинов и кафе.",
      "words": [1, 11, 22, 33, 48, 53, 70, 75]
    },
    {
      "id": "a72",
      "scene": 7,
      "from": 2698,
      "frames": 61,
      "text": "Ссылка в описании — заходите.",
      "words": [0, 1, 5, 27]
    }
  ]
}
